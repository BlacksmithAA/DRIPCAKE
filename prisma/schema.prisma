// Schema de Prisma — Sistema de Pedidos (Dripcake)
// Documento de referencia: 01-documento-requerimientos.md (sección 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Usuarios ──────────────────────────────────────────────────────────────
// Roles: 'cliente' | 'empleado' | 'admin'
model Usuario {
  id            String   @id @default(cuid())
  nombre        String
  telefono      String
  email         String   @unique
  passwordHash  String
  rol           String   // 'cliente' | 'empleado' | 'admin'
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pedidos       Pedido[]

  @@index([rol])
}

// ─── Catálogo ──────────────────────────────────────────────────────────────
model Producto {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  precio      Float    // en USD
  unidadVenta String   // ej. "unidad", "paquete de 12"
  cantidadMin Int      @default(1)
  cantidadMax Int      @default(50)
  stockSemanal Int?    // null = sin control de stock; número = unidades disponibles por semana (viernes + sábado)
  imagenUrl   String?  // foto de muestra del producto
  videoUrl    String?  // video corto de muestra del producto
  activo      Boolean  @default(true)
  archivado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemsPedido ItemPedido[]
}

// ─── Días no laborables ────────────────────────────────────────────────────
model DiaNoLaborable {
  id          String   @id @default(cuid())
  fecha       DateTime // día específico no laborable
  tipo        String   // 'feriado' | 'vacaciones' | 'eventualidad'
  descripcion String
  recurrente  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([fecha])
}

// ─── Pedidos ───────────────────────────────────────────────────────────────
// Estados del ticket (columna kanban): 'recibido' | 'en_preparacion' | 'listo' | 'entregado' | 'cancelado' | 'no_retirado'
model Pedido {
  id                String   @id @default(cuid())
  clienteId         String
  cliente           Usuario  @relation(fields: [clienteId], references: [id])
  fechaHoraRetiro   DateTime // programado en hora de Panamá
  estadoTicket      String   @default("recibido")
  pagado            Boolean  @default(false)
  entregado         Boolean  @default(false)
  noShow            Boolean  @default(false)
  costoTotal        Float
  qrRetiroToken     String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ItemPedido[]

  @@index([clienteId])
  @@index([fechaHoraRetiro])
  @@index([estadoTicket])
}

// ─── Ítems de pedido ───────────────────────────────────────────────────────
model ItemPedido {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  nombreProducto String   // snapshot del nombre del producto al momento del pedido
  precioUnitario Float    // snapshot del precio unitario al momento del pedido
  subtotal       Float

  @@index([pedidoId])
  @@index([productoId])
}

// ─── Configuración del sistema (singleton, una sola fila) ──────────────────
model ConfiguracionSistema {
  id                 Int      @id @default(1)
  whatsappContacto   String?  // número de WhatsApp del negocio, formato internacional, ej. "+50760000000"
  updatedAt          DateTime @updatedAt
}
